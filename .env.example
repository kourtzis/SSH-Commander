# MikroManager environment — copy this file to `.env` in the same directory
# as the docker-compose file and fill in the required values.
# `docker compose` reads `.env` automatically. NEVER commit your real .env.

# ── Required ─────────────────────────────────────────────────────────────
# Postgres password. The very first boot initializes the database with it.
# Changing it later requires `ALTER USER mikromanager PASSWORD '...'` inside
# the db container, then updating this value to match.
DB_PASSWORD=

# Session-cookie signing secret. Generate: openssl rand -hex 32
# Rotating it logs every user out; nothing else is affected.
SESSION_SECRET=

# AES-256-GCM key encrypting device credentials stored in the database.
# Generate: openssl rand -hex 32
# BACK THIS UP. Losing it permanently bricks every stored device password.
CREDENTIAL_ENCRYPTION_KEY=

# ── Optional ─────────────────────────────────────────────────────────────
# Admin password for the account created on the very first start (min 8
# chars). If left empty, a random password is generated and written to a
# mode-0600 file inside the app container (path printed in the boot log).
INITIAL_ADMIN_PASSWORD=

# Host port the app is published on (docker-compose.prod.yml only).
APP_PORT=3000

# Session cookie `Secure` flag — set to false only when serving plain HTTP
# with no HTTPS reverse proxy in front.
COOKIE_SECURE=true

# Trusted reverse-proxy hops in front of the app (affects client-IP
# detection for rate limiting and the audit log).
TRUST_PROXY_HOPS=1
